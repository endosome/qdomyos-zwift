          "off": "Strength 30-40 min: squats, step-ups, lunges, calf raises, plank. Stop if anything hurts."
        },
        {
          "day": "Thu",
          "training": "mr-strength-endurance-60",
          "note": "RPE 5-6, even effort."
        },
        {
          "day": "Sat",
          "training": "trail-rolling-terrain-60"
        },
        {
          "day": "Sun",
          "off": "Easy outdoor run or walk, or rest."
