        },
        {
          "day": "Wed",
          "off": "Strength 30-40 min: squats, step-ups, lunges, calf raises, plank. Stop if anything hurts."
        },
        {
          "day": "Thu",
          "training": "skimo-base-60",
          "note": "Hold RPE 4-5 the whole way."
        },
        {
          "day": "Fri",
          "off": "Rest."
        },
        {
          "day": "Sat",
          "training": "hike-base-60"
        },
        {
          "day": "Sun",
          "off": "Easy outdoor walk or rest."
        }
      ]
    },
