{
  "id": "plan-trail-runner-8w",
  "name": "Trail and mountain running, 8 weeks (running mode)",
  "goal": "For runners: build uphill running strength and pacing on the treadmill with real running speeds, hill repeats, tempo and vertical intervals, then taper.",
  "audience": "Healthy runners who already run regularly. Needs the console's handrail raised (running mode) and the staged running-mode validation (run-7 to run-12) done first; the CLI refuses speeds that are not validated. The treadmill has no downhill, so add outdoor running for descents.",
  "weeks": [
    {
      "week": 1,
      "focus": "Base: easy running and rolling terrain",
      "sessions": [
        {
          "day": "Tue",
          "training": "hike-recovery-35",
          "note": "Easy walk to start the week."
        },
        {
          "day": "Wed",
          "off": "Strength 30-40 min: squats, step-ups, lunges, calf raises, plank. Stop if anything hurts."
        },
        {
          "day": "Thu",
          "training": "trail-run-progression-45",
          "note": "Ease in; the last steps are brisk, not hard."
        },
        {
          "day": "Sat",
          "training": "trail-run-rolling-60"
        },
        {
          "day": "Sun",
          "off": "Easy outdoor run or rest."
        }
      ]
    },
    {
      "week": 2,
      "focus": "Base: first hill repeats",
