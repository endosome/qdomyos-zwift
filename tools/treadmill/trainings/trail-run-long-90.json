{
  "id": "trail-run-long-90",
  "name": "Trail run long 90",
  "description": "A long easy-to-moderate trail day with power-hike climbs. UNPROVEN LENGTH: the longest run on this treadmill so far is 62 minutes. Needs the console in running mode and --running-mode.",
  "sport": "running",
  "sub_sport": "trail",
  "steps": [
