{
  "id": "trail-run-rolling-60",
  "name": "Trail run rolling terrain 60",
  "description": "A fixed rolling-trail loop (easy running, climbs, fast flats, short steep pitches) repeated four times. No downhill is possible on this machine. Needs the console in running mode and --running-mode.",
  "sport": "running",
  "sub_sport": "trail",
  "steps": [
    {
      "ramp": {
        "name": "Warm-up",
        "minutes": 6,
        "speed_from": 5.0,
        "speed_to": 7.0,
        "level_from": 0,
        "level_to": 1,
        "step_minutes": 1,
        "intensity": "warmup",
        "notes": "Easy jog or brisk walk, relaxed shoulders."
      }
    },
    {
      "repeat": 4,
      "steps": [
        {
          "name": "Rolling",
          "minutes": 4,
          "speed": 8.0,
          "level": 2,
          "intensity": "active",
          "notes": "RPE 4-5."
        },
        {
          "name": "Climb",
          "minutes": 3,
          "speed": 7.0,
          "level": 5,
          "intensity": "active",
          "notes": "RPE 6."
        },
        {
          "name": "Fast flat",
          "minutes": 3,
          "speed": 9.5,
          "level": 1,
          "intensity": "active",
          "notes": "RPE 6."
        },
        {
          "name": "Steep pitch",
          "minutes": 2,
          "speed": 6.5,
          "level": 7,
          "intensity": "active",
          "notes": "RPE 7: power-hike if needed."
        }
      ]
    },
    {
      "ramp": {
        "name": "Cooldown",
        "minutes": 6,
        "speed_from": 6.0,
        "speed_to": 3.0,
        "level_from": 1,
        "level_to": 0,
        "step_minutes": 1,
        "intensity": "cooldown",
        "notes": "Walk it off; let the breathing settle."
      }
    }
  ]
}
